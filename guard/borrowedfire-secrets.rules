# Borrowed Fire secret guard for Codex. Managed by install.sh; local edits are replaced.
#
# Codex runs these prefix rules without the hook trust step, so they apply even before the
# owner trusts the secret-guard hook. They match plain commands, and the commands Codex can split
# out of a simple `bash -lc` chain. The hook covers everything else once trusted.

prefix_rule(
    pattern = [["op", "op-unattended"], ["item", "items"], "get"],
    decision = "forbidden",
    justification = "Item reads print every field, secrets included. Use bf-secret --env NAME=op://vault/item/field -- command.",
)

prefix_rule(
    pattern = [["op", "op-unattended"], ["read", "inject"]],
    decision = "forbidden",
    justification = "This prints secret values. Use bf-secret to give the secret to the command that needs it.",
)

prefix_rule(
    pattern = [["op", "op-unattended"], ["document", "documents"], "get"],
    decision = "forbidden",
    justification = "This prints the document. Use bf-secret --file NAME=op://vault/item/file -- command.",
)

prefix_rule(
    pattern = [["op", "op-unattended"], "run", "--no-masking"],
    decision = "forbidden",
    justification = "Unmasked op run prints secret values.",
)

prefix_rule(
    pattern = [["security", "/usr/bin/security"], ["find-generic-password", "find-internet-password", "dump-keychain"]],
    decision = "forbidden",
    justification = "Keychain reads can print passwords. Use bf-secret --env NAME=keychain:SERVICE -- command.",
)
