#!/bin/sh
# Borrowed Fire secret guard launcher. install.sh registers it as a Claude Code and Codex hook and
# links bf-secret to it. See secret_guard.py for what each mode does.
#
# It looks for Python 3 at fixed paths and never runs the macOS /usr/bin/python3 stub, which can
# open an install dialog. A 'pre' check fails closed: if no Python can run the guard, the tool call
# is blocked (exit 2) instead of allowed.

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd -P)
guard="$here/secret_guard.py"

case $(basename "$0") in
  bf-secret) set -- run "$@" ;;
esac
mode=${1:-}

# One candidate per line, so a developer directory with spaces stays one path.
developer_dir=$(/usr/bin/xcode-select -p 2>/dev/null)
candidates="/opt/homebrew/bin/python3
/usr/local/bin/python3
/Library/Developer/CommandLineTools/usr/bin/python3"
[ -n "$developer_dir" ] && candidates="$developer_dir/usr/bin/python3
$candidates"
[ "$(uname -s)" = Darwin ] || candidates="$candidates
/usr/bin/python3"
IFS='
'

if [ "$mode" = pre ] || [ "$mode" = post ]; then
  # Hooks: keep the event so another Python can retry it if one fails to start.
  event=$(cat)
  for python in $candidates; do
    [ -x "$python" ] || continue
    printf '%s' "$event" | "$python" -I -S -B "$guard" "$@"
    status=$?
    [ "$mode" = post ] && exit 0
    # 0 allows and 2 blocks. A Python stopped by a signal (128+) counts as a block, so a killed
    # or runaway check never starts another one. Other codes mean this Python could not run
    # the guard: try the next.
    case $status in
      0) exit 0 ;;
      2) exit 2 ;;
    esac
    if [ "$status" -ge 128 ]; then
      echo "BLOCKED: the Borrowed Fire secret guard was stopped before it finished, so the call was stopped to stay safe." >&2
      exit 2
    fi
  done
  if [ "$mode" = pre ]; then
    echo "BLOCKED: the Borrowed Fire secret guard could not start Python 3, so it cannot check this call. Install Python 3 (Xcode command line tools or Homebrew)." >&2
    exit 2
  fi
  exit 0
fi

for python in $candidates; do
  [ -x "$python" ] && exec "$python" -I -S -B "$guard" "$@"
done
echo "secret-guard: no Python 3 found (Xcode command line tools or Homebrew)" >&2
exit 1
