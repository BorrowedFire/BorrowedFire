#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
Usage: install-local-agent-worker --host SSH_HOST

Deploy the credential-free local Codex agent helper and build its pinned ARM64
container image on an authorized worker. Model endpoints remain in the private
Prometheus fleet configuration and are not copied by this installer.
EOF
}

host=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) host=${2:?--host requires an SSH host}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 64 ;;
  esac
done

[[ "$host" =~ ^[A-Za-z0-9._@-]+$ ]] || { echo "A safe --host is required" >&2; exit 64; }

root=$(cd "$(dirname "$0")/.." && pwd)
source_dir=".local/src/borrowedfire/codex-local-0.145.0"

ssh -o BatchMode=yes "$host" bash -s -- "$source_dir" <<'REMOTE'
set -Eeuo pipefail
source_dir=${1:?missing source directory}
mkdir -p "$HOME/$source_dir" "$HOME/.local/bin"
REMOTE
scp \
  "$root/docker/codex-local/Dockerfile" \
  "$root/docker/codex-local/agent-entrypoint" \
  "$host:~/$source_dir/"
scp "$root/tools/bf-local-agent-remote" "$host:~/.local/bin/bf-local-agent-remote"

ssh -o BatchMode=yes "$host" bash -s -- "$source_dir" <<'REMOTE'
set -Eeuo pipefail
source_dir=${1:?missing source directory}
chmod 0755 "$HOME/.local/bin/bf-local-agent-remote" "$HOME/$source_dir/agent-entrypoint"
docker build --tag borrowedfire/codex-local:0.145.0 "$HOME/$source_dir"
docker image inspect borrowedfire/codex-local:0.145.0 --format '{{.Id}} {{.Architecture}}'
REMOTE
