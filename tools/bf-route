#!/usr/bin/env python3
"""Deterministic Borrowed Fire model router.

The router reads private endpoint configuration from Prometheus, sends bounded
local work to the isolated GB10 agent worker, and uses Codex only when policy or
local failure requires paid judgment. Claude is intentionally not a route.
"""

from __future__ import annotations

import argparse
import base64
import dataclasses
import datetime as dt
import fnmatch
import hashlib
import json
import os
import pathlib
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile
from typing import Sequence


EXIT_USAGE = 64
EXIT_TEMPFAIL = 75
EXIT_PAID_REQUIRED = 78

JUDGMENT_PATTERNS = (
    r"\b(?:code |pr )?review(?: session)?\b",
    r"\bfinal (?:code )?review\b",
    r"\bindependent review\b",
    r"\bowner brief\b",
    r"\barchitecture (?:decision|plan|review)\b",
    r"\bsecurity (?:review|audit|decision)\b",
    r"\bplan(?:ning)?\b",
    r"\bdeploy(?:ment)?\b",
    r"\brelease\b",
)

OWNER_GATED_PATTERNS = (
    r"(?:^|/)migrations?(?:/|$)",
    r"\bschema\b",
    r"\brls\b",
    r"\bauth(?:entication|orization)?\b",
    r"\b(?:auth|user|login) sessions?\b",
    r"\bsession (?:token|cookie|management)\b",
    r"\bpermissions?\b",
    r"\bpayments?\b",
    r"\bbilling\b",
    r"\biap\b",
    r"\bsecrets?\b",
    r"\bsigning\b",
    r"\bproduction data\b",
    r"\bdestructive\b",
    r"\bdeploy(?:ment)?\b",
    r"\brelease\b",
)

QUALITY_PATTERNS = (
    r"\bdebug\b",
    r"\binvestigat(?:e|ion)\b",
    r"\broot cause\b",
    r"\brepo[- ]wide\b",
    r"\brefactor\b",
    r"\brace condition\b",
    r"\bconcurrenc(?:y|t)\b",
    r"\bflaky\b",
    r"\bcomplex\b",
    r"\badversarial\b",
)


@dataclasses.dataclass(frozen=True)
class RouteDecision:
    tier: str
    reason: str
    owner_gated: bool = False


@dataclasses.dataclass(frozen=True)
class Tier:
    name: str
    endpoint: str
    model: str


def brain_dir() -> pathlib.Path:
    explicit = os.environ.get("PROMETHEUS_DIR")
    if explicit:
        return pathlib.Path(explicit).expanduser().resolve()
    pointer = pathlib.Path("~/.config/borrowedfire/brain").expanduser()
    if pointer.is_file():
        value = pointer.read_text(encoding="utf-8").strip()
        if value:
            return pathlib.Path(value).expanduser().resolve()
    return pathlib.Path("~/prometheus").expanduser().resolve()


def load_tiers(path: pathlib.Path | None = None) -> dict[str, Tier]:
    fleet = path or brain_dir() / "config" / "fleet.md"
    try:
        text = fleet.read_text(encoding="utf-8")
    except OSError as error:
        raise RuntimeError(f"cannot read fleet configuration: {fleet}: {error}") from error

    tiers: dict[str, Tier] = {}
    pattern = re.compile(
        r"^\|\s*(local-(?:volume|quality))\s*\|\s*`(https?://[^`]+)`\s*"
        r"\(`([^`]+)`,\s*[^)]*\)\s*\|",
        re.MULTILINE,
    )
    for match in pattern.finditer(text):
        name, endpoint, model = match.groups()
        if "<" in endpoint or "<" in model:
            raise RuntimeError(f"fleet tier {name} still contains template placeholders")
        if not re.fullmatch(r"https?://[A-Za-z0-9._:-]+/v1", endpoint):
            raise RuntimeError(f"fleet tier {name} has an unsafe endpoint")
        if not re.fullmatch(r"[A-Za-z0-9._/-]+", model):
            raise RuntimeError(f"fleet tier {name} has an unsafe model name")
        tiers[name] = Tier(name=name, endpoint=endpoint.rstrip("/"), model=model)
    missing = {"local-volume", "local-quality"} - tiers.keys()
    if missing:
        raise RuntimeError(f"fleet configuration is missing tiers: {', '.join(sorted(missing))}")
    return tiers


def load_worker_host(path: pathlib.Path | None = None) -> str:
    fleet = path or brain_dir() / "config" / "fleet.md"
    try:
        text = fleet.read_text(encoding="utf-8")
    except OSError as error:
        raise RuntimeError(f"cannot read fleet configuration: {fleet}: {error}") from error
    match = re.search(r"^- Controller SSH host:\s*`([^`]+)`\s*$", text, re.MULTILINE)
    if not match or not re.fullmatch(r"[A-Za-z0-9._@-]+", match.group(1)):
        raise RuntimeError("fleet configuration is missing a safe Controller SSH host")
    return match.group(1)


def load_task_timeout(path: pathlib.Path | None = None) -> int:
    fleet = path or brain_dir() / "config" / "fleet.md"
    try:
        text = fleet.read_text(encoding="utf-8")
    except OSError as error:
        raise RuntimeError(f"cannot read fleet configuration: {fleet}: {error}") from error
    match = re.search(r"^- Local task timeout seconds:\s*`([^`]+)`\s*$", text, re.MULTILINE)
    if not match or not match.group(1).isdigit():
        raise RuntimeError("fleet configuration is missing a numeric Local task timeout seconds")
    timeout = int(match.group(1))
    if not 30 <= timeout <= 7200:
        raise RuntimeError("Local task timeout seconds must be between 30 and 7200")
    return timeout


def load_transport_timeout(path: pathlib.Path | None = None) -> int:
    fleet = path or brain_dir() / "config" / "fleet.md"
    try:
        text = fleet.read_text(encoding="utf-8")
    except OSError as error:
        raise RuntimeError(f"cannot read fleet configuration: {fleet}: {error}") from error
    match = re.search(r"^- Local transport timeout seconds:\s*`([^`]+)`\s*$", text, re.MULTILINE)
    if not match or not match.group(1).isdigit():
        raise RuntimeError("fleet configuration is missing a numeric Local transport timeout seconds")
    timeout = int(match.group(1))
    if not 10 <= timeout <= 600:
        raise RuntimeError("Local transport timeout seconds must be between 10 and 600")
    return timeout


def validate_worker_host(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9._@-]+", value):
        raise RuntimeError("worker SSH host contains unsafe characters")
    return value


def matches_any(text: str, patterns: Sequence[str]) -> bool:
    return any(re.search(pattern, text, re.IGNORECASE | re.MULTILINE) for pattern in patterns)


def classify(task: str, files: Sequence[str] = ()) -> RouteDecision:
    material = "\n".join((task, *files))
    owner_gated = matches_any(material, OWNER_GATED_PATTERNS)
    if owner_gated:
        return RouteDecision("judgment", "owner-gated risk policy", owner_gated=True)
    if matches_any(material, JUDGMENT_PATTERNS):
        return RouteDecision("judgment", "paid judgment policy")
    if matches_any(material, QUALITY_PATTERNS):
        return RouteDecision("local-quality", "complexity policy")
    return RouteDecision("local-volume", "bounded work default")


def run_checked(command: Sequence[str], **kwargs) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, check=True, text=True, **kwargs)


def git(repo: pathlib.Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        check=check,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def repository_state(repo_value: str, ref: str) -> tuple[pathlib.Path, str]:
    repo = pathlib.Path(repo_value).expanduser().resolve()
    if not repo.is_dir():
        raise RuntimeError(f"repository does not exist: {repo}")
    top = pathlib.Path(git(repo, "rev-parse", "--show-toplevel").stdout.strip()).resolve()
    commit = git(top, "rev-parse", "--verify", f"{ref}^{{commit}}").stdout.strip()
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise RuntimeError(f"could not resolve a full commit for {ref}")
    return top, commit


def safe_slug(repo: pathlib.Path) -> str:
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", repo.name).strip("-")
    if not slug:
        raise RuntimeError("repository name does not produce a safe worker slug")
    return slug


def state_root() -> pathlib.Path:
    root = pathlib.Path("~/.local/state/borrowedfire-route").expanduser()
    root.mkdir(parents=True, exist_ok=True)
    return root


def append_ledger(entry: dict[str, object]) -> None:
    ledger = state_root() / "ledger.jsonl"
    with ledger.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")


def repository_slug(repo: pathlib.Path) -> str | None:
    remote = git(repo, "remote", "get-url", "origin", check=False)
    if remote.returncode == 0:
        match = re.search(r"github\.com(?::|/)([^/\s]+/[^/\s]+?)(?:\.git)?$", remote.stdout.strip())
        if match:
            return match.group(1)
    return None


def project_denylist_extras(repo: pathlib.Path) -> list[str]:
    projects = brain_dir() / "projects"
    if not projects.is_dir():
        return []
    wanted = repository_slug(repo)
    candidates: list[tuple[pathlib.Path, str]] = []
    for page in projects.glob("*.md"):
        try:
            text = page.read_text(encoding="utf-8")
        except OSError:
            continue
        repo_match = re.search(r"^repo:\s*([^\s]+)\s*$", text, re.MULTILINE)
        if not repo_match:
            continue
        registered = repo_match.group(1).strip('"\'')
        if wanted and registered.casefold() == wanted.casefold():
            candidates = [(page, text)]
            break
        if not wanted and registered.rsplit("/", 1)[-1].casefold() == repo.name.casefold():
            candidates.append((page, text))
    if len(candidates) != 1:
        return []
    text = candidates[0][1]
    inline = re.search(r"^denylist_extra:\s*\[([^]]*)\]\s*$", text, re.MULTILINE)
    if inline:
        return [item.strip().strip('"\'') for item in inline.group(1).split(",") if item.strip()]
    block = re.search(r"^denylist_extra:\s*$((?:\n[ \t]+-[^\n]*)+)", text, re.MULTILINE)
    if not block:
        return []
    return [
        match.group(1).strip().strip('"\'')
        for match in re.finditer(r"^[ \t]+-\s*(.+?)\s*$", block.group(1), re.MULTILINE)
    ]


def authoritative_patch_patterns(repo: pathlib.Path) -> tuple[list[str], list[str]]:
    policy = pathlib.Path(__file__).resolve().parents[1] / "skills" / "land" / "references" / "denylist.md"
    try:
        text = policy.read_text(encoding="utf-8")
    except OSError as error:
        raise RuntimeError(f"cannot load authoritative denylist: {error}") from error
    paths = re.findall(r"<!-- bf-route-path: (.+?) -->", text)
    content = re.findall(r"<!-- bf-route-content: (.+?) -->", text)
    if not paths or not content:
        raise RuntimeError("authoritative denylist is missing router enforcement rules")
    for extra in project_denylist_extras(repo):
        escaped = re.escape(extra)
        paths.append(fnmatch.translate(extra) if any(character in extra for character in "*?[") else escaped)
        content.append(escaped)
    return paths, content


def ssh_base(worker: str) -> list[str]:
    return [
        "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
        "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=2", worker,
    ]


def remote_home(worker: str, transport_timeout: int) -> str:
    try:
        process = subprocess.run(
            [*ssh_base(worker), "printf '%s' \"$HOME\""],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=transport_timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("timed out while determining the worker home") from error
    home = process.stdout.strip()
    if process.returncode or not re.fullmatch(r"/[A-Za-z0-9._/-]+", home):
        raise RuntimeError(f"could not determine a safe home directory on worker {worker}")
    return home.rstrip("/")


def stream_archive(
    worker: str,
    repo: pathlib.Path,
    commit: str,
    remote_workspace: str,
    transport_timeout: int,
) -> None:
    try:
        mkdir = subprocess.run(
            [*ssh_base(worker), f"mkdir -p {shlex.quote(remote_workspace)}"],
            check=False,
            timeout=transport_timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("timed out while creating the worker workspace") from error
    if mkdir.returncode:
        raise RuntimeError("could not create the managed GB10 workspace")
    archive = subprocess.Popen(["git", "-C", str(repo), "archive", "--format=tar", commit], stdout=subprocess.PIPE)
    assert archive.stdout is not None
    try:
        extract = subprocess.run(
            [*ssh_base(worker), f"tar -xf - -C {shlex.quote(remote_workspace)}"],
            stdin=archive.stdout,
            check=False,
            timeout=transport_timeout,
        )
    except subprocess.TimeoutExpired as error:
        archive.stdout.close()
        archive.kill()
        archive.wait()
        raise RuntimeError("timed out while transferring the repository snapshot") from error
    else:
        archive.stdout.close()
        archive_status = archive.wait()
    if archive_status or extract.returncode:
        subprocess.run(
            [*ssh_base(worker), f"rm -rf {shlex.quote(remote_workspace)}"],
            check=False,
            timeout=transport_timeout,
        )
        raise RuntimeError("failed to transfer the exact repository snapshot to GB10")


def copy_remote_artifact(
    worker: str,
    worker_home: str,
    slug: str,
    remote: str,
    artifact_name: str,
    destination: pathlib.Path,
    transport_timeout: int,
) -> None:
    prefix = f"{worker_home}/.local/state/borrowedfire-route/{slug}/"
    relative = remote.removeprefix(prefix)
    parts = pathlib.PurePosixPath(relative).parts
    if not remote.startswith(prefix) or len(parts) != 3 or parts[1:] != ("artifacts", artifact_name):
        raise RuntimeError(f"worker returned an unsafe artifact path: {remote}")
    try:
        run_checked(
            [
                "scp", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=2",
                f"{worker}:{remote}", str(destination),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=transport_timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f"timed out while retrieving {artifact_name}") from error


def local_attempt(
    worker: str,
    repo: pathlib.Path,
    commit: str,
    task: str,
    tier: Tier,
    mode: str,
    timeout_seconds: int,
    transport_timeout: int,
) -> tuple[int, pathlib.Path | None, pathlib.Path | None, str]:
    timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run_id = f"{timestamp}-{os.getpid()}-{tier.name}"
    slug = safe_slug(repo)
    worker_home = remote_home(worker, transport_timeout)
    remote_workspace = f"{worker_home}/.cache/borrowedfire-route/{slug}/{commit}-{run_id}"
    output_dir = state_root() / slug / run_id
    output_dir.mkdir(parents=True, exist_ok=False)
    controller_log = output_dir / "controller.log"
    stream_archive(worker, repo, commit, remote_workspace, transport_timeout)

    encoded = base64.b64encode(task.encode()).decode()
    result_nonce = secrets.token_hex(16)
    remote_arguments = [
        remote_workspace,
        slug,
        commit,
        tier.endpoint,
        tier.model,
        tier.name,
        mode,
        encoded,
        result_nonce,
        str(timeout_seconds),
    ]
    remote_command = "~/.local/bin/bf-local-agent-remote " + " ".join(
        shlex.quote(argument) for argument in remote_arguments
    )
    command = [*ssh_base(worker), remote_command]
    try:
        process = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
            timeout=timeout_seconds + 90,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f"local worker exceeded its {timeout_seconds}-second task timeout") from error
    finally:
        try:
            subprocess.run(
                [*ssh_base(worker), f"rm -rf {shlex.quote(remote_workspace)}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
                timeout=transport_timeout,
            )
        except subprocess.TimeoutExpired:
            pass
    controller_log.write_text(process.stdout, encoding="utf-8")
    sys.stdout.write(process.stdout)

    patch_remote = None
    final_remote = None
    patch_marker = f"BF_RESULT_{result_nonce}_PATCH="
    final_marker = f"BF_RESULT_{result_nonce}_FINAL="
    for line in process.stdout.splitlines():
        if line.startswith(patch_marker):
            patch_remote = line.partition("=")[2]
        elif line.startswith(final_marker):
            final_remote = line.partition("=")[2]

    patch = output_dir / "changes.patch" if patch_remote else None
    final = output_dir / "final.txt" if final_remote else None
    if patch_remote and patch:
        copy_remote_artifact(
            worker, worker_home, slug, patch_remote, "changes.patch", patch, transport_timeout
        )
    if final_remote and final:
        copy_remote_artifact(worker, worker_home, slug, final_remote, "final.txt", final, transport_timeout)

    validate_attempt_artifacts(mode, process.returncode, patch, final)

    return process.returncode, patch, final, run_id


def validate_attempt_artifacts(
    mode: str,
    status: int,
    patch: pathlib.Path | None,
    final: pathlib.Path | None,
) -> None:
    if status != 0:
        return
    if not final or not final.is_file() or final.stat().st_size == 0:
        raise RuntimeError("worker reported success without an authenticated final artifact")
    if mode == "code" and (not patch or not patch.is_file() or patch.stat().st_size == 0):
        raise RuntimeError("worker reported code success without an authenticated patch artifact")


def checkout_is_clean_at(repo: pathlib.Path, commit: str) -> bool:
    head = git(repo, "rev-parse", "HEAD").stdout.strip()
    status = git(repo, "status", "--porcelain").stdout
    return head == commit and not status


def patch_paths(repo: pathlib.Path, patch: pathlib.Path) -> list[str]:
    with tempfile.TemporaryDirectory(prefix="bf-route-index-") as directory:
        index = pathlib.Path(directory) / "index"
        environment = os.environ.copy()
        environment["GIT_INDEX_FILE"] = str(index)
        try:
            run_checked(
                ["git", "-C", str(repo), "read-tree", "HEAD"],
                env=environment,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            run_checked(
                ["git", "-C", str(repo), "apply", "--cached", str(patch)],
                env=environment,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            process = subprocess.run(
                [
                    "git", "-C", str(repo), "diff", "--cached", "--name-status", "-z",
                    "--find-renames=1%", "HEAD",
                ],
                env=environment,
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
        except subprocess.CalledProcessError as error:
            detail = error.stderr or ""
            message = (
                detail.decode(errors="replace") if isinstance(detail, bytes) else detail
            ).strip()
            raise RuntimeError(f"cannot inspect generated patch: {message}") from error

    fields = process.stdout.split(b"\0")
    paths: list[str] = []
    position = 0
    while position < len(fields) and fields[position]:
        status = fields[position].decode("ascii", errors="replace")
        position += 1
        path_count = 2 if status.startswith(("R", "C")) else 1
        if position + path_count > len(fields):
            raise RuntimeError("cannot inspect generated patch paths")
        for field in fields[position:position + path_count]:
            if not field:
                raise RuntimeError("cannot inspect generated patch paths")
            paths.append(field.decode("utf-8", errors="surrogateescape"))
        position += path_count
    return paths


def validate_generated_patch(repo: pathlib.Path, patch: pathlib.Path) -> None:
    paths = patch_paths(repo, patch)
    path_patterns, content_patterns = authoritative_patch_patterns(repo)
    risky_paths = [path for path in paths if matches_any(path, path_patterns)]
    patch_text = patch.read_text(encoding="utf-8", errors="replace")
    if risky_paths or matches_any(patch_text, content_patterns):
        detail = ", ".join(risky_paths) if risky_paths else "sensitive content"
        raise RuntimeError(
            "refusing to apply an owner-gated generated patch "
            f"({detail}); paid review and explicit owner action are required"
        )


def apply_patch(repo: pathlib.Path, commit: str, patch: pathlib.Path) -> None:
    if not checkout_is_clean_at(repo, commit):
        raise RuntimeError("refusing to apply: checkout is dirty or HEAD moved since routing began")
    validate_generated_patch(repo, patch)
    run_checked(["git", "-C", str(repo), "apply", "--check", str(patch)])
    run_checked(["git", "-C", str(repo), "apply", str(patch)])


def paid_attempt(repo: pathlib.Path, commit: str, task: str, mode: str) -> tuple[int, pathlib.Path | None, pathlib.Path | None, str]:
    if not shutil.which("codex"):
        raise RuntimeError("Codex CLI is not installed on this controller")
    timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run_id = f"{timestamp}-{os.getpid()}-codex"
    slug = safe_slug(repo)
    output_dir = state_root() / slug / run_id
    output_dir.mkdir(parents=True, exist_ok=False)
    final = output_dir / "final.txt"
    patch = output_dir / "changes.patch"
    worktree_root = state_root() / "worktrees"
    worktree_root.mkdir(parents=True, exist_ok=True)
    worktree = pathlib.Path(tempfile.mkdtemp(prefix=f"{slug}-", dir=worktree_root))
    worktree.rmdir()
    try:
        run_checked(["git", "-C", str(repo), "worktree", "add", "--detach", str(worktree), commit])
        sandbox = "workspace-write" if mode == "code" else "read-only"
        process = subprocess.run(
            [
                "codex", "exec", "--ephemeral", "--sandbox", sandbox,
                "--disable", "multi_agent", "-C", str(worktree),
                "-o", str(final), task,
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
        (output_dir / "controller.log").write_text(process.stdout, encoding="utf-8")
        sys.stdout.write(process.stdout)
        if mode == "code":
            git(worktree, "add", "-N", ".", check=False)
        diff = git(worktree, "diff", "--binary", commit, check=False)
        patch.write_text(diff.stdout, encoding="utf-8")
        if mode == "code" and process.returncode == 0 and not diff.stdout.strip():
            return 10, patch, final if final.exists() else None, run_id
        validate_attempt_artifacts(
            mode,
            process.returncode,
            patch if patch.exists() else None,
            final if final.exists() else None,
        )
        return process.returncode, patch, final if final.exists() else None, run_id
    finally:
        subprocess.run(["git", "-C", str(repo), "worktree", "remove", "--force", str(worktree)], check=False)


def forced_decision(value: str, task: str, files: Sequence[str]) -> RouteDecision:
    policy = classify(task, files)
    if value == "auto" or policy.tier == "judgment":
        return policy
    if value == "volume":
        return RouteDecision("local-volume", "explicit tier override")
    if value == "quality":
        return RouteDecision("local-quality", "explicit tier override")
    return RouteDecision("judgment", "explicit tier override")


def print_decision(decision: RouteDecision) -> None:
    print(f"ROUTE={decision.tier}")
    print(f"REASON={decision.reason}")
    print(f"OWNER_GATED={'yes' if decision.owner_gated else 'no'}")
    print("CLAUDE_ELIGIBLE=no")


def command_decide(args: argparse.Namespace) -> int:
    print_decision(forced_decision(args.tier, args.task, args.file))
    return 0


def command_run(args: argparse.Namespace) -> int:
    repo, commit = repository_state(args.repo, args.ref)
    decision = forced_decision(args.tier, args.task, args.file)
    print_decision(decision)
    if args.dry_run:
        print(f"REPOSITORY={repo}")
        print(f"COMMIT_SHA={commit}")
        print("EXECUTED=no")
        return 0

    task_hash = hashlib.sha256(args.task.encode()).hexdigest()
    attempts: list[str] = []
    final_patch: pathlib.Path | None = None
    final_message: pathlib.Path | None = None
    status = 1
    run_id = ""

    if decision.tier == "judgment":
        if not args.allow_paid:
            print("PAID_ESCALATION_REQUIRED=yes")
            print("No paid model was invoked. Re-run with --allow-paid to use Codex.")
            status = EXIT_PAID_REQUIRED
        else:
            attempts.append("codex")
            status, final_patch, final_message, run_id = paid_attempt(repo, commit, args.task, args.mode)
    else:
        tiers = load_tiers()
        worker = validate_worker_host(args.worker) if args.worker else load_worker_host()
        timeout_seconds = load_task_timeout()
        transport_timeout = load_transport_timeout()
        route_order = [decision.tier]
        if decision.tier == "local-volume":
            route_order.append("local-quality")
        for tier_name in route_order:
            attempts.append(tier_name)
            try:
                status, final_patch, final_message, run_id = local_attempt(
                    worker,
                    repo,
                    commit,
                    args.task,
                    tiers[tier_name],
                    args.mode,
                    timeout_seconds,
                    transport_timeout,
                )
            except (RuntimeError, subprocess.CalledProcessError, OSError) as error:
                status = EXIT_TEMPFAIL
                print(f"ATTEMPT_ERROR={tier_name}:{error}")
            if status == 0:
                break
            print(f"ATTEMPT_FAILED={tier_name}:{status}")
        if status and args.allow_paid:
            attempts.append("codex")
            status, final_patch, final_message, run_id = paid_attempt(repo, commit, args.task, args.mode)
        elif status:
            print("PAID_ESCALATION_REQUIRED=yes")

    if status == 0 and args.apply:
        if args.mode != "code" or not final_patch or not final_patch.exists() or not final_patch.read_text().strip():
            raise RuntimeError("there is no code patch to apply")
        apply_patch(repo, commit, final_patch)
        print("PATCH_APPLIED=yes")
    elif final_patch:
        print(f"PATCH_LOCAL={final_patch}")
    if final_message:
        print(f"FINAL_LOCAL={final_message}")

    append_ledger({
        "timestamp": dt.datetime.now(dt.timezone.utc).isoformat(),
        "repository": str(repo),
        "commit": commit,
        "task_hash": task_hash,
        "decision": decision.tier,
        "reason": decision.reason,
        "owner_gated": decision.owner_gated,
        "claude_eligible": False,
        "attempts": attempts,
        "status": status,
        "run_id": run_id,
        "applied": bool(status == 0 and args.apply),
    })
    return status


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description="Route Borrowed Fire work between GB10 and Codex; Claude is excluded.")
    commands = root.add_subparsers(dest="command", required=True)

    decide = commands.add_parser("decide", help="print the deterministic route without executing")
    decide.add_argument("--task", required=True)
    decide.add_argument("--file", action="append", default=[])
    decide.add_argument("--tier", choices=("auto", "volume", "quality", "judgment"), default="auto")
    decide.set_defaults(handler=command_decide)

    run = commands.add_parser("run", help="execute a routed task in an isolated snapshot")
    run.add_argument("--repo", required=True)
    run.add_argument("--task", required=True)
    run.add_argument("--ref", default="HEAD")
    run.add_argument("--file", action="append", default=[])
    run.add_argument("--tier", choices=("auto", "volume", "quality", "judgment"), default="auto")
    run.add_argument("--worker", help="SSH host override; defaults to the private fleet configuration")
    run.add_argument("--mode", choices=("code", "advice"), default="code")
    run.add_argument("--dry-run", action="store_true")
    run.add_argument("--allow-paid", action="store_true", help="permit Codex escalation; Claude is never used")
    run.add_argument("--apply", action="store_true", help="apply a clean patch only if HEAD and worktree are unchanged")
    run.set_defaults(handler=command_run)
    return root


def main(argv: Sequence[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        return args.handler(args)
    except (RuntimeError, subprocess.CalledProcessError, OSError) as error:
        print(f"ERROR={error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
